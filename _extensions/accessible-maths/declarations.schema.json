{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:accessible-maths:declarations:1",
  "title": "Accessible Maths declarations, schema 1, shared contract v0 slice",
  "description": "Inert public document metadata. Explicit native declarations and their rendered definition occurrences only. No inferred expression identity, relations, source spans, dependency digest or complete KG snapshot. Document-local occurrence IDs require a collection scope before cross-page merging.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "kind",
    "producer",
    "scope",
    "coverage",
    "objects",
    "occurrences"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contractVersion": {
      "const": "0"
    },
    "kind": {
      "const": "accessible-maths-declarations"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "accessible-maths"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "source",
        "occurrenceIds"
      ],
      "properties": {
        "type": {
          "const": "document"
        },
        "source": {
          "type": "string"
        },
        "occurrenceIds": {
          "const": "document-local"
        }
      }
    },
    "coverage": {
      "const": "explicit-native-declarations-only"
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object"
      }
    },
    "occurrences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/occurrence"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "anchor",
        "precision"
      ],
      "properties": {
        "document": {
          "type": "string",
          "description": "Containing project-relative QMD, including for composed partials."
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        },
        "precision": {
          "const": "anchor"
        }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "labels",
        "origin",
        "reviewStatus",
        "source",
        "publication"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
        },
        "type": {
          "enum": [
            "thm",
            "lem",
            "cor",
            "prp",
            "cnj",
            "def",
            "exm",
            "exr"
          ]
        },
        "labels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "language",
              "text"
            ],
            "properties": {
              "language": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "origin": {
          "const": "author-declared"
        },
        "reviewStatus": {
          "const": "not-asserted"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "licence"
          ],
          "properties": {
            "decision": {
              "const": "rendered-source"
            },
            "licence": {
              "const": "not-asserted"
            }
          }
        },
        "notation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "roles",
            "intent",
            "visualTeX"
          ],
          "properties": {
            "command": {
              "type": "string",
              "pattern": "^am[A-Z][A-Za-z]*$"
            },
            "roles": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "Exact Unicode XML 1.0 Fifth Edition NCName; Lua additionally enforces 64 UTF-8 bytes. No case or Unicode normalization."
              }
            },
            "intent": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "description": "Bounded MathML 4 Working Draft 2026-10-02 intent grammar including properties and nested applications. Runtime additionally enforces 2048 UTF-8 bytes, parser budgets and exactly one reference to each declared role. This structural schema alone does not parse the grammar or verify mathematical meaning."
            },
            "visualTeX": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "signature": {
              "$ref": "#/$defs/signature"
            },
            "lexicalScope": {
              "$ref": "#/$defs/lexicalScope"
            }
          }
        }
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "source",
        "destination"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Document-local rendered anchor; not a semantic entity ID."
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "destination": {
          "type": "string",
          "pattern": "^#"
        }
      }
    },
    "lexicalScope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "document"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "anchor"
          ],
          "properties": {
            "kind": {
              "const": "div"
            },
            "anchor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "parameters"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "parameters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "kind"
            ],
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "kind": {
                "enum": [
                  "required",
                  "optional"
                ]
              },
              "defaultTeX": {
                "type": "string",
                "minLength": 0,
                "maxLength": 1024
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "optional"
                    }
                  }
                },
                "then": {
                  "required": [
                    "defaultTeX"
                  ]
                },
                "else": {
                  "not": {
                    "required": [
                      "defaultTeX"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
